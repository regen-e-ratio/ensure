# Server environment variables for Google SSO (feature 002-google-sso-auth).
# Copy to server/.env (git-ignored) and fill in real values. Never commit secrets.

# Google OAuth 2.0 Web application client (from the Google Cloud Console).
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Must exactly match an Authorized redirect URI on the Google client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Long random string used to sign the ~1h access-token JWT. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-with-a-long-random-string

# TEST ONLY — when set to 1, mounts POST /api/test/login (mints a fake-user session
# without contacting Google) for e2e/contract tests. NEVER enable in production.
# AUTH_TEST_MODE=1
