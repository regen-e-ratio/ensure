# Server environment variables for Google SSO (feature 002-google-sso-auth).
# Copy to server/.env (git-ignored) and fill in real values. Never commit secrets.

# Google OAuth 2.0 Web application client (from the Google Cloud Console).
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Must exactly match an Authorized redirect URI on the Google client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Long random string used to sign the ~1h access-token JWT. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-with-a-long-random-string

# TEST ONLY — when set to 1, mounts POST /api/test/login (mints a fake-user session
# without contacting Google) for e2e/contract tests. NEVER enable in production.
# AUTH_TEST_MODE=1

# Note encryption keyring (feature 004-note-ownership-encryption). The server refuses
# to boot if these are missing/invalid (fail closed). A key is 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NOTE_ENC_KEYS — comma-separated version:base64key entries (all versions available to
#   DECRYPT). NOTE_ENC_ACTIVE_VERSION — the version used to ENCRYPT new/updated notes;
#   it MUST be one of the versions in NOTE_ENC_KEYS. To rotate, add a new version and
#   point ACTIVE at it; retire the old version only once no note still uses it.
NOTE_ENC_KEYS=1:replace-with-base64-of-32-random-bytes
NOTE_ENC_ACTIVE_VERSION=1
